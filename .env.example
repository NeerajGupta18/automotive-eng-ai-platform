# Copy to .env and adjust:  cp .env.example .env
# The app reads .env automatically at start (real environment variables win).
# These defaults run fully offline with no downloads.
DATA_DIR=./storage

# --- LLM: mock | ollama | openai_compat
#   mock          offline extractive answerer (quotes the best-matching sentences); used by tests/CI
#   ollama        local model on your laptop:  ollama pull llama3.2:3b   (16 GB RAM: llama3.1:8b)
#   openai_compat any OpenAI-compatible server (vLLM, LM Studio, llama.cpp) or hosted API (e.g. Groq)
LLM_BACKEND=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_BASE_URL=http://localhost:8001/v1
OPENAI_MODEL=local-model
OPENAI_API_KEY=not-needed
LLM_TIMEOUT_S=120
# If the LLM fails, answer with the extractive fallback (flagged 'degraded') instead of an error
LLM_FALLBACK=1

# --- Embeddings: hash (offline) | sentence-transformers (needs: pip install -r requirements-ml.txt)
EMBED_BACKEND=hash
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Vector store: numpy | chroma
# After changing the store or the embedding model, rebuild vectors:  python scripts/manage.py reindex
VECTOR_BACKEND=numpy

# --- Retrieval (Phase 1)
# hybrid = BM25 keyword search + vector search fused with Reciprocal Rank Fusion (recommended)
# vector = vector search only (the Stage 1 behaviour)
RETRIEVAL_MODE=hybrid
# Refuse when less than this share of the question's key terms appears in the documents.
# Chosen with the sweep in eval/results/REPORT.md.
MIN_COVERAGE=0.5
# With semantic embeddings: let a paraphrased question through when the best chunk is this similar
RESCUE_MIN_SCORE=0.6
RESCUE_MIN_COVERAGE=0.2
# Optional second-stage reranking: none | cross-encoder (needs requirements-ml.txt, downloads a model)
RERANK_BACKEND=none
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_CHARS=1200
CHUNK_OVERLAP_CHARS=150
# Vector-mode refusal threshold (defaults: 0.12 hash, 0.30 sentence-transformers)
# MIN_SCORE=0.30
MAX_UPLOAD_MB=50
# Parse PDFs in a separate short-lived process (frees ~200 MB after each upload; isolates crashes of the parser).
# Recommended on small cloud instances; adds a few seconds per PDF upload.
PDF_PARSE_ISOLATION=0
PDF_PARSE_TIMEOUT_S=120

# --- Security and operations (Stage 5)
# off      = development: the X-User header is trusted, there is NO access control
# enforced = API tokens + per-project roles (viewer < engineer < reviewer < admin). Use this for anything shared.
AUTH_MODE=off
# Optional bootstrap admin token (>= 32 chars). If empty in enforced mode, one is generated and printed once at first start.
#   python -c "import secrets; print('aeai_' + secrets.token_urlsafe(32))"
ADMIN_TOKEN=
TOKEN_TTL_DAYS=90
# Per-user requests per minute (default 600 when enforced, off otherwise) and failed logins per client address per minute
# RATE_LIMIT_PER_MIN=600
AUTH_FAIL_LIMIT_PER_MIN=10
# Reject request bodies larger than this (default MAX_UPLOAD_MB + 2)
# MAX_REQUEST_MB=52
# text | json (json for log aggregation)
LOG_FORMAT=text
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# LOCAL AI PROFILE (MacBook / laptop). Replace the matching lines above with:
#   LLM_BACKEND=ollama
#   OLLAMA_MODEL=llama3.2:3b
#   EMBED_BACKEND=sentence-transformers
#   VECTOR_BACKEND=chroma
# then:  pip install -r requirements-ml.txt  &&  python scripts/manage.py reindex
# Full guide: docs/PHASE1_AI_QUALITY.md

# ---------------------------------------------------------------------------
# ADAS virtual validation (Phase 4). The AEB C code is compiled with `cc` (or $CC) for
# software-in-the-loop runs; macOS: xcode-select --install. Optional folder for prebuilt libraries:
# AEB_SIL_DIR=

# ---------------------------------------------------------------------------
# Agents and enterprise integration (Phase 5)
# Dry run by default: webhook deliveries and Jira tickets are prepared and signed but not sent.
INTEGRATIONS_LIVE=0
# Deliver webhook events in the background every N seconds (0 = only when "Deliver now" is pressed)
INTEGRATION_DISPATCH_S=0
# Webhook targets: optional host allow-list (comma separated); private/loopback addresses are blocked unless allowed
WEBHOOK_ALLOW_HOSTS=
WEBHOOK_ALLOW_PRIVATE=0
# Jira Cloud: JIRA_USER = account e-mail + JIRA_API_TOKEN; Jira Data Center: leave JIRA_USER empty, token = PAT
JIRA_BASE_URL=
JIRA_PROJECT_KEY=
JIRA_USER=
JIRA_API_TOKEN=
JIRA_ISSUE_TYPE=Task
AGENT_MAX_STEPS=25

# Field issues (Phase 6)
# A new field issue (complaints grouped by symptom and software build) starts the agent's investigation automatically
FIELD_AUTO_INVESTIGATE=1
# Let the configured LLM read complaint texts (validated JSON, falls back to the rules). Off: deterministic rules only.
# Complaint texts may contain personal data: enable only with an LLM you are allowed to send them to.
FIELD_TRIAGE_LLM=0

# ---------------------------------------------------------------------------
# CarSaathi car-owner app (Phase A): a separate service, `make owner-api` (API on :8100) and `make owner-web` (app on :5173).
# It reads only the OWNER_*, SMTP_* and BREVO_* lines below. Development needs none of them: SQLite in DATA_DIR, and the sign-in
# code is printed in the API's log instead of being emailed. Production settings: docs/PHASE_A_OWNER_APP.md
# OWNER_ENV=development
# PostgreSQL for real users (Neon / Supabase free tier): postgresql://user:password@host/db?sslmode=require
# OWNER_DATABASE_URL=
# At least 32 random characters in production (development keeps a generated one in DATA_DIR/.owner_secret):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# OWNER_SECRET_KEY=
# email | console (console prints the code in the log; the default in development)
# OWNER_OTP_DELIVERY=console
# Sender of the sign-in emails (must be a verified sender at your email provider)
# OWNER_MAIL_FROM=CarSaathi <you@example.com>
# Either Brevo's HTTPS API (works on Render's free plan, which blocks outgoing SMTP) ...
# BREVO_API_KEY=
# ... or any SMTP server, e.g. Gmail with an app password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# OWNER_DEMO_LOGIN=1
# owner/repo: "Download the Android app" goes to the latest GitHub release built by .github/workflows/android-app.yml
# OWNER_GITHUB_REPO=
# Reverse proxies in front of the service (Render: 1); 0 uses the connection's address
# OWNER_PROXY_HOPS=0
# Phase B, help. Reports to the manufacturer go to the engineering platform's field-issue API (Phase 6):
#   OWNER_FIELD_API_URL=http://127.0.0.1:8000  OWNER_FIELD_PROJECT=bcm-demo  OWNER_FIELD_LIVE=1  (0: prepared, never sent)
#   OWNER_FIELD_TOKEN: an engineer's API token when the platform runs with AUTH_MODE=enforced
# OWNER_FIELD_API_URL=
# OWNER_FIELD_PROJECT=bcm-demo
# OWNER_FIELD_TOKEN=
# OWNER_FIELD_LIVE=0
# Optional LLM (any OpenAI-compatible API) that may pick a guide when the search is unsure; it never writes steps
# OWNER_LLM_BASE_URL=https://api.groq.com/openai/v1
# OWNER_LLM_MODEL=llama-3.1-8b-instant
# OWNER_LLM_API_KEY=
# Bearer token (32+ characters) for the anonymous help statistics at /api/help/stats
# OWNER_ADMIN_TOKEN=
# Phase D, notifications and service booking (docs/PHASE_D_NOTIFICATIONS_BOOKING.md)
# The site's address for links in emails and the workshop's booking link (on Render, RENDER_EXTERNAL_URL is used if empty)
# OWNER_PUBLIC_URL=
# OWNER_REMINDER_EMAILS=1
# Bearer token (32+ characters) of the daily run, POST /api/notify/run; .github/workflows/owner-reminders.yml sends it
# OWNER_CRON_TOKEN=
# Web Push keys: `python -m owner.notify vapid` prints a pair (development makes one in DATA_DIR by itself)
# OWNER_VAPID_PUBLIC_KEY=
# OWNER_VAPID_PRIVATE_KEY=
# OWNER_VAPID_SUBJECT=mailto:you@example.com
