      <SPEC-TYPES>
        <SPEC-OBJECT-TYPE IDENTIFIER="OEM-SOT-SYSREQ" LAST-CHANGE="2026-09-01T09:00:00+05:30" LONG-NAME="System requirement">
          <SPEC-ATTRIBUTES>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="OEM-AD-ID" LAST-CHANGE="2026-09-01T09:00:00+05:30" LONG-NAME="ReqIF.ForeignID">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>OEM-DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="OEM-AD-NAME" LAST-CHANGE="2026-09-01T09:00:00+05:30" LONG-NAME="ReqIF.Name">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>OEM-DT-STRING</DATATYPE-DEFINITION-STRING-REF></TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="OEM-AD-VERIF" LAST-CHANGE="2026-09-01T09:00:00+05:30" LONG-NAME="Verification method">
