            </ATTRIBUTE-DEFINITION-XHTML>
            <ATTRIBUTE-DEFINITION-ENUMERATION IDENTIFIER="OEM-AD-PRIO" LAST-CHANGE="2026-09-01T09:00:00+05:30" LONG-NAME="Priority" MULTI-VALUED="false">
              <TYPE><DATATYPE-DEFINITION-ENUMERATION-REF>OEM-DT-PRIORITY</DATATYPE-DEFINITION-ENUMERATION-REF></TYPE>
            </ATTRIBUTE-DEFINITION-ENUMERATION>
          </SPEC-ATTRIBUTES>
        </SPEC-OBJECT-TYPE>
        <SPECIFICATION-TYPE IDENTIFIER="OEM-ST-DOC" LAST-CHANGE="2026-09-01T09:00:00+05:30" LONG-NAME="Requirements document"/>
      </SPEC-TYPES>
      <SPEC-OBJECTS>
        <SPEC-OBJECT IDENTIFIER="OEM-AEB-01" LAST-CHANGE="2026-09-01T09:00:00+05:30">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="CR-AEB-01"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>OEM-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Operating speed range"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>OEM-AD-NAME</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Test"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>OEM-AD-VERIF</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>OEM-AD-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>The AEB function shall initiate autonomous braking for vehicle speeds between 10 km/h and 85 km/h and shall warn the driver above 85 km/h.</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>OEM-AD-PRIO</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION>
              <VALUES><ENUM-VALUE-REF>OEM-EV-HIGH</ENUM-VALUE-REF></VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>OEM-SOT-SYSREQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="OEM-AEB-02" LAST-CHANGE="2026-09-01T09:00:00+05:30">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="CR-AEB-02"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>OEM-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Stationary vehicle ahead"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>OEM-AD-NAME</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Test"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>OEM-AD-VERIF</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>OEM-AD-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>The AEB function shall avoid a collision with a stationary passenger car ahead for vehicle speeds up to 50 km/h on a dry road.</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>OEM-AD-PRIO</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION>
              <VALUES><ENUM-VALUE-REF>OEM-EV-HIGH</ENUM-VALUE-REF></VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>OEM-SOT-SYSREQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="OEM-AEB-03" LAST-CHANGE="2026-09-01T09:00:00+05:30">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="CR-AEB-03"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>OEM-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Warning before braking"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>OEM-AD-NAME</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Test"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>OEM-AD-VERIF</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>OEM-AD-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>The forward collision warning shall be given at least 0.8 s before autonomous braking starts.</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>OEM-AD-PRIO</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION>
              <VALUES><ENUM-VALUE-REF>OEM-EV-MEDIUM</ENUM-VALUE-REF></VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>OEM-SOT-SYSREQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="OEM-AEB-04" LAST-CHANGE="2026-09-01T09:00:00+05:30">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="CR-AEB-04"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>OEM-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Robustness to false detections"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>OEM-AD-NAME</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Test"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>OEM-AD-VERIF</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>OEM-AD-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>Radar detections shorter than 100 ms without a real object shall not lead to a warning or to autonomous braking.</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>OEM-AD-PRIO</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION>
              <VALUES><ENUM-VALUE-REF>OEM-EV-HIGH</ENUM-VALUE-REF></VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>OEM-SOT-SYSREQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="OEM-AEB-05" LAST-CHANGE="2026-09-01T09:00:00+05:30">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="CR-AEB-05"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>OEM-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Driver braking"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>OEM-AD-NAME</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Test"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>OEM-AD-VERIF</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>OEM-AD-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>The brake request of the AEB function shall never reduce the deceleration requested by the driver.</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>OEM-AD-PRIO</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION>
              <VALUES><ENUM-VALUE-REF>OEM-EV-HIGH</ENUM-VALUE-REF></VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>OEM-SOT-SYSREQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="OEM-AEB-06" LAST-CHANGE="2026-09-01T09:00:00+05:30">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="CR-AEB-06"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>OEM-AD-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Hold after standstill"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>OEM-AD-NAME</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Test"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>OEM-AD-VERIF</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>OEM-AD-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
              <THE-VALUE><xhtml:div><xhtml:p>After an autonomous stop the vehicle shall be held at standstill while the object ahead is detected.</xhtml:p></xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>OEM-AD-PRIO</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION>
              <VALUES><ENUM-VALUE-REF>OEM-EV-MEDIUM</ENUM-VALUE-REF></VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>OEM-SOT-SYSREQ</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
      </SPEC-OBJECTS>
      <SPECIFICATIONS>
        <SPECIFICATION IDENTIFIER="OEM-SPEC-AEB" LAST-CHANGE="2026-09-01T09:00:00+05:30" LONG-NAME="AEB system requirements">
