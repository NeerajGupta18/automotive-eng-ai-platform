            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-XHTML IDENTIFIER="OEM-AD-TEXT" LAST-CHANGE="2026-09-01T09:00:00+05:30" LONG-NAME="ReqIF.Text">
