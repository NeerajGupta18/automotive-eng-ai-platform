  <THE-HEADER>
    <REQ-IF-HEADER IDENTIFIER="OEM-HDR-AEB-SYS-1">
      <COMMENT>Synthetic example of an OEM system requirement specification for AEB, version 1.</COMMENT>
      <CREATION-TIME>2026-09-01T09:00:00+05:30</CREATION-TIME>
      <REQ-IF-TOOL-ID>OEM requirements tool (synthetic example)</REQ-IF-TOOL-ID>
      <REQ-IF-VERSION>1.0</REQ-IF-VERSION>
      <SOURCE-TOOL-ID>OEM requirements tool (synthetic example)</SOURCE-TOOL-ID>
      <TITLE>OEM AEB system requirements v1</TITLE>
    </REQ-IF-HEADER>
  </THE-HEADER>
  <CORE-CONTENT>
    <REQ-IF-CONTENT>
      <DATATYPES>
        <DATATYPE-DEFINITION-STRING IDENTIFIER="OEM-DT-STRING" LAST-CHANGE="2026-09-01T09:00:00+05:30" LONG-NAME="Plain text" MAX-LENGTH="1000"/>
        <DATATYPE-DEFINITION-XHTML IDENTIFIER="OEM-DT-XHTML" LAST-CHANGE="2026-09-01T09:00:00+05:30" LONG-NAME="Formatted text"/>
        <DATATYPE-DEFINITION-ENUMERATION IDENTIFIER="OEM-DT-PRIORITY" LAST-CHANGE="2026-09-01T09:00:00+05:30" LONG-NAME="Priority">
          <SPECIFIED-VALUES>
            <ENUM-VALUE IDENTIFIER="OEM-EV-HIGH" LAST-CHANGE="2026-09-01T09:00:00+05:30" LONG-NAME="High">
              <PROPERTIES><EMBEDDED-VALUE KEY="0" OTHER-CONTENT=""/></PROPERTIES>
            </ENUM-VALUE>
            <ENUM-VALUE IDENTIFIER="OEM-EV-MEDIUM" LAST-CHANGE="2026-09-01T09:00:00+05:30" LONG-NAME="Medium">
              <PROPERTIES><EMBEDDED-VALUE KEY="1" OTHER-CONTENT=""/></PROPERTIES>
            </ENUM-VALUE>
            <ENUM-VALUE IDENTIFIER="OEM-EV-LOW" LAST-CHANGE="2026-09-01T09:00:00+05:30" LONG-NAME="Low">
              <PROPERTIES><EMBEDDED-VALUE KEY="2" OTHER-CONTENT=""/></PROPERTIES>
            </ENUM-VALUE>
          </SPECIFIED-VALUES>
        </DATATYPE-DEFINITION-ENUMERATION>
